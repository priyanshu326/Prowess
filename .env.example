# ==============================================================================
# Kisan Saathi / SmartKisan - Environment Example (.env.example)
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Fullstack Express & Vite Server Settings
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Cloud Run / Application hosting URL for callbacks and self-referential links
APP_URL=https://ais-dev-xrmiyrjzon27srfo5b3nwy-812604205099.asia-southeast1.run.app

# Vite HMR setting (set to true in AI Studio to prevent unnecessary reloads)
DISABLE_HMR=false

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# In AI Studio, GEMINI_API_KEY is injected at runtime from user secrets.
# Used for:
# - Crop Doctor (leaf disease diagnosis via gemini-3.8-flash)
# - Voice-first Query Transcription (via gemini-3.5-transcribe)
# - Kisan Saathi AI Sahayak Chatbot (via gemini-3.1-flash-lite)
# - Backend Agronomic Risk Explanations in colloquial Hindi/English
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_CHAT_MODEL="gemini-3.1-flash-lite"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"

# ------------------------------------------------------------------------------
# 3. Python FastAPI Backend Service Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
BACKEND_PORT=8000
APP_NAME="SmartKisan - AI-Powered Smart Irrigation Platform"
APP_VERSION="2.0.0"

# ------------------------------------------------------------------------------
# 4. Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY="replace-with-a-random-32-byte-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 5. Weather Provider & Climate Intelligence APIs
# ------------------------------------------------------------------------------
# Primary weather provider: 'open_meteo' (no key required), 'openweather', or 'mock'
WEATHER_PROVIDER="open_meteo"
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_TIMEOUT_SECONDS=10.0
OPEN_METEO_MAX_RETRIES=3

# Optional: OpenWeatherMap API (used if WEATHER_PROVIDER is set to 'openweather')
OPENWEATHER_API_KEY=""
OPENWEATHER_BASE_URL="https://api.openweathermap.org/data/2.5"

# Caching parameters to prevent API rate limits and conserve bandwidth
WEATHER_CACHE_TTL_SECONDS=1800
ALLOW_STALE_CACHE_ON_FAILURE=true

# ------------------------------------------------------------------------------
# 6. Database Configuration
# ------------------------------------------------------------------------------
# Default: Local SQLite database for instant zero-dependency execution
DATABASE_URL="sqlite:///./kisaan_risk.db"

# Optional: PostgreSQL / Supabase connection string for production scale
# DATABASE_URL="postgresql://kisaan_user:kisaan_pass@localhost:5432/kisaan_irrigation"
POSTGRES_USER="kisaan_user"
POSTGRES_PASSWORD="kisaan_pass"
POSTGRES_DB="kisaan_irrigation"
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 7. Economic & Agronomic Baseline Constants
# ------------------------------------------------------------------------------
DEFAULT_DIESEL_PRICE_INR=89.0
DEFAULT_ELECTRICITY_TARIFF_INR=7.0
DIESEL_PUMP_LPH=1.25
ELECTRIC_PUMP_KW=5.6
DEFAULT_PUMP_FLOW_RATE_LPH=25000.0
TRADITIONAL_FLOOD_BASELINE_MM=65.0
CO2_KG_PER_LITRE_DIESEL=2.68
ML_MODEL_ENABLED=false

# ------------------------------------------------------------------------------
# 8. Frontend Client (Vite) Environment Variables
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="/api"
VITE_APP_TITLE="Kisan Saathi - Sowing & Harvesting Risk Intelligence"
