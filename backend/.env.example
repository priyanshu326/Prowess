# Environment configuration for Kisaan Sathi Decision Intelligence API
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Weather Provider (Default: open_meteo)
WEATHER_PROVIDER="open_meteo"
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_TIMEOUT_SECONDS=10.0
OPEN_METEO_MAX_RETRIES=3

# Cache Configuration
WEATHER_CACHE_TTL_SECONDS=1800

# Database Configuration (Default: local SQLite; replace with postgresql://user:pass@host:5432/db for Supabase/Cloud SQL)
DATABASE_URL="sqlite:///./kisaan_risk.db"

# Optional ML Model Switch
ML_MODEL_ENABLED=false
