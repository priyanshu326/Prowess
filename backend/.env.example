# ==============================================================================
# SmartKisan FastAPI Backend - Environment Example (.env.example)
# Copy this file to .env and configure for your environment.
# ==============================================================================

# Application Runtime Configuration
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
APP_NAME="SmartKisan - AI-Powered Smart Irrigation Platform"
APP_VERSION="2.0.0"

# Google Gemini AI API Configuration
# Used by agronomic risk engine for generating farmer-friendly explanations in Hindi/English
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"

# Security & JWT Authentication
JWT_SECRET_KEY="your-random-32-byte-secret-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Weather Provider (Default: open_meteo; optional: openweather, mock)
WEATHER_PROVIDER="open_meteo"
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_TIMEOUT_SECONDS=10.0
OPEN_METEO_MAX_RETRIES=3

# OpenWeatherMap API (Optional: used if WEATHER_PROVIDER="openweather")
OPENWEATHER_API_KEY="your-openweather-api-key-here"
OPENWEATHER_BASE_URL="https://api.openweathermap.org/data/2.5"

# Caching Configuration
WEATHER_CACHE_TTL_SECONDS=1800
ALLOW_STALE_CACHE_ON_FAILURE=true

# Database Configuration (Default: local SQLite; replace with PostgreSQL/Supabase for production)
# SQLite: sqlite:///./kisaan_risk.db
# PostgreSQL: postgresql://kisaan_user:kisaan_pass@localhost:5432/kisaan_irrigation
DATABASE_URL="sqlite:///./kisaan_risk.db"
POSTGRES_USER="kisaan_user"
POSTGRES_PASSWORD="kisaan_pass"
POSTGRES_DB="kisaan_irrigation"

# Economic Baseline Constants
DEFAULT_DIESEL_PRICE_INR=89.0
DEFAULT_ELECTRICITY_TARIFF_INR=7.0
DIESEL_PUMP_LPH=1.25
ELECTRIC_PUMP_KW=5.6
DEFAULT_PUMP_FLOW_RATE_LPH=25000.0
TRADITIONAL_FLOOD_BASELINE_MM=65.0
CO2_KG_PER_LITRE_DIESEL=2.68

# ML & Agronomic Evaluation Engine
ML_MODEL_ENABLED=false
